### Global Settings

DEBIANVER=bookworm
GOLANGVER=1.24.1
PROJECTS="function-as-a-service function-trigger"

LOG_DEV_MODE=true
LOG_LEVEL=trace

### Function As A Service Settings

FAAS_EXECUTION_TIMEOUT=10
FAAS_PARALLEL_EXECUTION_LIMIT=2

FAAS_STORAGE_BACKEND=scylla
FAAS_STORAGE_TABLE_SCYLLA=function_as_a_service_executions
FAAS_STORAGE_TTL=10
FAAS_STORAGE_USERNAME=function-as-a-service
FAAS_STORAGE_PASSWORD=faaspass

### Function Trigger Settings

FT_RABBITMQ_VHOST=cloud-toolbox-ft
FT_RABBITMQ_USER=function-trigger
FT_RABBITMQ_PASSWORD=ft-password
FT_RABBITMQ_QUEUE=ft.function-as-a-service
FT_RABBITMQ_DLX=ft.dead-letter-exchange

### RabbitMQ Settings

RABBITMQ_CONTAINER=test-rabbitmq-1
RABBITMQ_HOST=test-rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_SSL=false
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=admin

### Redis Settings

REDIS_HOST=test-redis-1
REDIS_PORT=6379

### Scylla Settings

SCYLLA_CONTAINER=test-scylla-1
SCYLLA_HOST=test-scylla-1
SCYLLA_PORT=8000
SCYLLA_REGION=eu-central-1
SCYLLA_ACCESS_KEY_ID=local
SCYLLA_SECRET_ACCESS_KEY=local
